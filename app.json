{
  "expo": {
    "name": "AI Travel",
    "slug": "mobileapp-frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "mobileappfrontend",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.azas01.mobileappfrontend"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.azas01.mobileappfrontend"
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "sentry-expo",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "note": "Use SENTRY_AUTH_TOKEN env to authenticate with Sentry.",
          "project": "ai-travel",
          "organization": "hcmut-short"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/26630826-37a0-4c5e-8836-396dfbc2eb74"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c03d6764-a231-4e44-8da3-a41df24daa64"
      }
    },
    "owner": "elfbe"
  }
}
